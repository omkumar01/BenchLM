# BenchLM Environment Variables
# Copy this file to .env and modify as needed

# Application
BENCHLM_APP_DEBUG=false
BENCHLM_APP_LOG_LEVEL=INFO
BENCHLM_APP_THEME=dark
BENCHLM_APP_ACCENT_COLOR=#6366F1

# Database
BENCHLM_DATABASE_PATH=~/.benchlm/benchlm.db

# Benchmark Defaults
BENCHLM_BENCHMARK_DEFAULT_PROVIDER=ollama
BENCHLM_BENCHMARK_OLLAMA_HOST=http://localhost:11434
BENCHLM_BENCHMARK_LLAMA_CPP_HOST=http://localhost:8080
BENCHLM_BENCHMARK_LMSTUDIO_HOST=http://localhost:1234
BENCHLM_BENCHMARK_VLLM_HOST=http://localhost:8000

BENCHLM_BENCHMARK_TEMPERATURE=0.7
BENCHLM_BENCHMARK_TOP_P=0.9
BENCHLM_BENCHMARK_MAX_TOKENS=2048
BENCHLM_BENCHMARK_ITERATIONS=10
BENCHLM_BENCHMARK_WARMUP_RUNS=2

# Hardware Monitoring
BENCHLM_HARDWARE_GPU_BACKEND=auto
BENCHLM_HARDWARE_NVIDIA_GPU_INDEX=0

# Exports
BENCHLM_EXPORTS_DEFAULT_DIRECTORY=~/BenchLM_Exports
BENCHLM_EXPORTS_PDF_ENGINE=reportlab