# =============================================================================
BENCHLM_EXPORTS_DEFAULT_DIRECTORY=~/BenchLM_Exports
BENCHLM_EXPORTS_FORMATS=csv,json,html,pdf,sqlite
BENCHLM_EXPORTS_PDF_ENGINE=reportlab
BENCHLM_EXPORTS_INCLUDE_CHARTS_IN_PDF=true
BENCHLM_EXPORTS_INCLUDE_RAW_DATA=false

